# TON Network
NETWORK=testnet
RPC_URL=https://testnet.toncenter.com/api/v2/jsonRPC
API_KEY=YOUR_TONCENTER_API_KEY

# Deployer Wallet
DEPLOYER_MNEMONIC="your 24-word mnemonic here"
DEPLOYER_ADDRESS=EQXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Walrus Configuration
WALRUS_RPC=https://walrus-testnet-rpc.example.com
WALRUS_KEY=your_walrus_key
WALRUS_AGGREGATOR_URL=https://walrus-testnet.example.com

# Contract Addresses (filled after deployment)
FACTORY_ADDRESS=
PROFILE_ADDRESS=
DEX_ADDRESS=
LP_STAKING_ADDRESS=
HANDLE_FEE_VAULT_ADDRESS=

# Frontend Configuration
VITE_API_URL=http://localhost:3001
VITE_NETWORK=testnet
VITE_FACTORY_ADDRESS=
VITE_WALLET_SOURCE=https://ton-connect.github.io/wallets-list/json/wallets-list.json

# Backend Configuration
BACKEND_PORT=3001
BACKEND_HOST=localhost
JWT_SECRET=your_jwt_secret_key
DATABASE_URL=
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
