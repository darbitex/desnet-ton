{
  "name": "desnet-ton",
  "version": "0.1.0",
  "description": "Decentralized Social Network on TON Blockchain",
  "license": "Unlicense",
  "private": true,
  "workspaces": [
    "contracts",
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "create:wallet": "ts-node scripts/create-wallet.ts",
    "deploy:testnet": "ts-node scripts/deploy-testnet.ts",
    "test:smoke": "ts-node scripts/smoke-test.ts",
    "contracts:compile": "cd contracts && npm run compile",
    "contracts:test": "cd contracts && npm run test",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "backend:dev": "cd backend && npm run dev",
    "backend:build": "cd backend && npm run build"
  },
  "devDependencies": {
    "@ton/crypto": "^4.0.0",
    "@ton/ton": "^13.0.0",
    "dotenv": "^16.0.0",
    "prettier": "^3.0.0",
    "eslint": "^8.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
